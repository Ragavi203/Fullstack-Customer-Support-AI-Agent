# Optional. Without a key the agent runs in demo mode: keyword routing, local embeddings,
# a deterministic tool state machine, and grounded template replies.
# With a key, the model routes each turn (intent, standalone search query, tool plan)
# and phrases the reply. Tools, policy checks, and grounding checks run the same either way.

# xAI (Grok). Used when XAI_API_KEY is set, unless LLM_PROVIDER says otherwise.
XAI_API_KEY=
# The non-reasoning model answers in under a second, which suits voice.
# grok-4.7 is stronger but slower; pair it with XAI_REASONING_EFFORT=low.
XAI_MODEL=grok-4.20-0309-non-reasoning
# Only for reasoning models such as grok-4.7: low, medium, high, or xhigh.
XAI_REASONING_EFFORT=
# Voice mode speaks with xAI text to speech when XAI_API_KEY is set.
# ara is a warm support voice. Others: sal, rex, iris, carina, eve. Set to off for the browser voice.
XAI_TTS_VOICE=ara

# OpenAI. Also powers policy embeddings when set; xAI has no embeddings API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Force a chat provider when both keys are set: xai or openai.
LLM_PROVIDER=

# Embedding model used to index support policies. Falls back to local
# hashed embeddings if the key is missing or the embeddings call fails.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Retrieval scoring: hybrid (BM25 + embeddings, default), vector, or keyword.
RAG_MODE=hybrid

# Confidence cutoff on the retrieval score. Leave empty for the default:
# 0.26 for local hybrid (calibrated by npm run eval), 0.38 for OpenAI hybrid.
RAG_CONFIDENCE_THRESHOLD=

# Requests allowed per session and per IP each minute.
RATE_LIMIT_PER_MINUTE=20

# Artificial pauses so streamed step indicators are visible. Set to 0 in tests.
TOOL_PACE_MS=320
TOKEN_PACE_MS=16

# How long a simulated model timeout waits before the fallback state.
SIMULATE_TIMEOUT_MS=2500
